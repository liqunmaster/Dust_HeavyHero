{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "D:/MCU/zephyr/zephyrproject/.venv/Scripts/west.exe",
            "args": [
                "build", "-b", "hpm5361icb",
                "-s", "${workspaceFolder}",
                "-d", "${workspaceFolder}/build",
                "-p", "always"
            ],
            "options": {
                "cwd": "D:/MCU/zephyr/zephyrproject",
                "env": {
                    "ZEPHYR_BASE": "D:/MCU/zephyr/zephyrproject/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "D:/MCU/zephyr/zephyr-sdk",
                    "HPM_SDK_DIR": "D:/MCU/hpm/hpm_sdk"
                }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Flash",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& '${workspaceFolder}\\Script\\build&flash.cmd'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
