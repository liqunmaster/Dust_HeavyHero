{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "D:/MCU/zephyr/zephyrproject/.venv/Scripts/west.exe build -b hpm5361icb -d build -p always",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "D:/MCU/zephyr/zephyrproject/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "D:/MCU/zephyr/zephyr-sdk",
                    "HPM_SDK_DIR": "D:/MCU/hpm/hpm_sdk"
                }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "flash",
            "type": "shell",
            "command": "D:/MCU/hpm/tools/openocd/openocd.exe",
            "args": [
                "-s", "D:/MCU/hpm/tools/openocd/tcl",
                "-f", "${workspaceFolder}/Board/hpm5361/hpm5361_flash.cfg"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}