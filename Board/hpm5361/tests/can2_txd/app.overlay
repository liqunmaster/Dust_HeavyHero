#include <dt-bindings/pinctrl/hpmicro-pinctrl-common.h>

&pinctrl {
	can2_txd_gpio: can2-txd-gpio {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 0), IOC_TYPE_PIOC, 0, 3)>;
		};
		group1 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 0), IOC_TYPE_IOC, 0, 0)>;
		};
	};
};

&can2 {
	status = "disabled";
};

&gpioy {
	pinctrl-0 = <&can2_txd_gpio>;
	pinctrl-names = "default";
	status = "okay";
};
