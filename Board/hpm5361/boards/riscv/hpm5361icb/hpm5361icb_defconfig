CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
# Execute from the HPM5361 1 MiB in-package flash. SPI1/W25Q128 remains
# reserved for application logs and is not part of the boot image.
CONFIG_XIP=y
CONFIG_HPM_BOOT_HEADER=y
CONFIG_SOC_ANDES_V5_PMA=n

# pinctrl driver option
CONFIG_PINCTRL=y

# GPIO driver option
CONFIG_GPIO=y

# Serial driver option
CONFIG_SERIAL=y

# CAN0 is physically routed to PB00/PB01 through the on-board TJA1042.
CONFIG_CAN=y
